# ==============================================================================
# TITLE MUNKE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=https://title-munke.vercel.app

# Environment Mode: 'production' | 'staging' | 'development'
NEXT_PUBLIC_DEFAULT_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# AI Provider API Keys
# ------------------------------------------------------------------------------
# OpenAI API Key (from platform.openai.com)
OPENAI_API_KEY=

# Anthropic Claude API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini API Key (from aistudio.google.com)
GOOGLE_AI_API_KEY=
